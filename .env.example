# ─── WOLKS Monitor — Variables d'environnement ───────────────
# Copie ce fichier en .env pour le dev local (jamais commité)

# Twelve Data — gratuit 800 req/jour — https://twelvedata.com
TWELVE_DATA_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ntfy.sh — topic push (installe l'app ntfy sur ton téléphone)
NTFY_TOPIC=wolks-emre-2024

# Paires surveillées (séparées par des virgules)
PAIRS=EUR/USD,GBP/USD,GBP/JPY,XAU/USD,XAG/USD

# Intervalle entre chaque scan (minutes)
SCAN_INTERVAL_MIN=30

# Seuil de score pour déclencher une notification
CONFLUENCE_THRESHOLD=5

# Scan uniquement pendant les sessions London/NY (true/false)
SESSION_ONLY=true

# Port Express (Render le définit automatiquement)
PORT=3001
